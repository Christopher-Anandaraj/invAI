# Backend Configuration
BACKEND_URL=http://localhost:8000

# API Keys (Server-side only - never use NEXT_PUBLIC_ prefix for sensitive keys)
# These keys should NEVER be committed to the repository
GEMINI_API_KEY=your_gemini_api_key_here
FINNHUB_API_KEY=your_finnhub_api_key_here

# Robinhood Credentials (Server-side only)
ROBINHOOD_USERNAME=your_robinhood_username
ROBINHOOD_PASSWORD=your_robinhood_password

# SECURITY NOTE:
# - Never use NEXT_PUBLIC_ prefix for API keys or secrets
# - NEXT_PUBLIC_ variables are exposed to the browser
# - All sensitive API calls should go through server-side routes
# - Never log API responses that might contain sensitive data
# - Keep API keys in environment variables, never hardcode them
