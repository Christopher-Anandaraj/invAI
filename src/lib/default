# HTTP to HTTPS redirection for backend.chrisbuilds.dev
server {
    listen 80;
    listen [::]:80;
    server_name backend.chrisbuilds.dev;

    return 301 https://$host$request_uri;
}

# HTTPS server for backend.chrisbuilds.dev with FastAPI proxy
server {
    listen 443 ssl;
    listen [::]:443 ssl ipv6only=on;
    server_name backend.chrisbuilds.dev;

    ssl_certificate /etc/letsencrypt/live/backend.chrisbuilds.dev/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/backend.chrisbuilds.dev/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

